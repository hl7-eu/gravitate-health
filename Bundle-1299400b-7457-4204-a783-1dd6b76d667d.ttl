       fhir:text [
         fhir:status [ fhir:v "generated" ] ;
         fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p> </p></div>"^^rdf:XMLLiteral ]
       ] ;
       fhir:section ( [
         fhir:id [ fhir:v "b287cf62-ae9d-470e-ae81-720ad8a5c7a9" ] ;
         fhir:title [ fhir:v "Composición deSalazopyrina" ] ;
         fhir:code [
           fhir:coding ( [
             fhir:system [ fhir:v "http://spor.ema.europa.eu/v1/lists/200000029659"^^xsd:anyURI ] ;
             fhir:code [ fhir:v "200000029915" ] ;
             fhir:display [ fhir:v "Composición deSalazopyrina" ]
           ] )
         ] ;
         fhir:text [
           fhir:status [ fhir:v "generated" ] ;
           fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><ul><li><span>El principio activo es sulfasalazina. Cada comprimido contiene 500 mg de sulfasalazina.</span></li><li><span>Los demás componentes son: povidona, almidón de maíz, estearato de magnesio y dióxido de silicio coloidal.</span></li></ul><p><span> </span></p></div>"^^rdf:XMLLiteral ]
         ]
       ] [
         fhir:id [ fhir:v "b6a57cc8-5b55-4dde-b3de-5487d6b689ee" ] ;
         fhir:title [ fhir:v "Aspecto del producto y tamaño del envase" ] ;
         fhir:code [
           fhir:coding ( [
             fhir:system [ fhir:v "http://spor.ema.europa.eu/v1/lists/200000029659"^^xsd:anyURI ] ;
             fhir:code [ fhir:v "200000029916" ] ;
             fhir:display [ fhir:v "Aspecto del producto y tamaño del envase" ]
           ] )
         ] ;
         fhir:text [
           fhir:status [ fhir:v "generated" ] ;
           fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><span>Los comprimidos de Salazopyrina 500 mg son de color amarillo-naranja, redondos, convexos, con las letras “KPh” impresas en una cara y la otra cara ranurada y con el código de producto “101” impreso.</span></p><p><span>La ranura es únicamente para poder fraccionar y facilitar la deglución pero no para dividir en dosis iguales.</span></p><p><span> </span></p><p><span>Los comprimidos se acondicionan en frascos de polietileno con tapa de rosca de polipropileno. El envase contiene 50 comprimidos.</span></p><p><span> </span></p></div>"^^rdf:XMLLiteral ]
         ]

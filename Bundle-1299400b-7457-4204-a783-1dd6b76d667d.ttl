       fhir:text [
         fhir:status [ fhir:v "generated" ] ;
         fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><em><span> </span></em></p><p><span>Salazopyrina 500 mg comprimidos</span></p><p><span> </span></p></div>"^^rdf:XMLLiteral ]
       ]
     ] [
       fhir:id [ fhir:v "5e46d3c8-ee23-4304-b96e-262b30df1bbf" ] ;
       fhir:title [ fhir:v "2. Composición cualitativa y cuantitativa" ] ;
       fhir:code [
         fhir:coding ( [

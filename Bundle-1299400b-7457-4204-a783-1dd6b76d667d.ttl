         fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><strong><span> </span></strong></p><div><ol><li><a name=\"OLE_LINK1\" id=\"OLE_LINK1\"/><a name=\"OLE_LINK2\" id=\"OLE_LINK2\"><strong><span>Lista de excipiente</span></strong></a><strong><span>s</span></strong></li></ol></div><p><span> </span></p><p><span>Povidona, almidón de maíz, estearato de magnesio, dióxido de silicio coloidal.</span></p></div>"^^rdf:XMLLiteral ]
       ] ;

           fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><span> </span></p><p><span>Titular de la autorización de comercialización: Pfizer, S.L. Avda. de Europa, 20-B. Parque Empresarial La Moraleja. 28108, Alcobendas (Madrid). España</span></p><p><span> </span></p><p><span>Responsable de la fabricación: Recipharm Uppsala</span><span>AB. Bjökgatan, 30. Uppsala.</span><span>Domkyrkofors. Uppsala, 753 23.</span><span>Suecia</span></p><p><span> </span></p><p><span> </span></p><p><strong><span>Este prospecto ha sido aprobado en noviembre de 2022</span></strong></p><p><strong><span> </span></strong></p><p><span>La información detallada y actualizada de este medicamento está disponible en la página web de la Agencia Española de Medicamentos y Productos Sanitarios (AEMPS) http://www.aemps.es/</span></p></div>"^^rdf:XMLLiteral ]

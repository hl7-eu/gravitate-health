           ] )
         ] ;
         fhir:text [
           fhir:status [ fhir:v "generated" ] ;
           fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><span> </span></p><p><span>Ninguna especial.</span></p><p><span>La eliminación del medicamento no utilizado y de todos los materiales que hayan estado en contacto con él, se realizará de acuerdo con la normativa local.</span></p><p><span> </span></p></div>"^^rdf:XMLLiteral ]

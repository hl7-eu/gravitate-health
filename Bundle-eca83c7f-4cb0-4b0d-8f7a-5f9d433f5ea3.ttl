         fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><em><span> </span></em></p><p><span>Recto Menaderm 0,125 mg/g pomada rectal</span></p><p><span> </span></p></div>"^^rdf:XMLLiteral ]

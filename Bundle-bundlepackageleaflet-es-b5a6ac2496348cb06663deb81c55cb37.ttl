     ] [
       fhir:title [ fhir:v "4. Posibles efectos adversos" ] ;
       fhir:code [
         fhir:coding ( [
           fhir:system [ fhir:v "https://spor.ema.europa.eu/rmswi/"^^xsd:anyURI ] ;

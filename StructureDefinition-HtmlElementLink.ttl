       fhir:path [ fhir:v "Extension.extension" ] ;
       fhir:sliceName [ fhir:v "type" ] ;
       fhir:short [ fhir:v "Type of data, e.g. image, video, text, etc." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;

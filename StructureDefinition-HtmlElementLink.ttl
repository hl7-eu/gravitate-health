         fhir:code [ fhir:v "string"^^xsd:anyURI ]
       ] )
     ] [
       fhir:id [ fhir:v "Extension.extension:concept" ] ;
       fhir:path [ fhir:v "Extension.extension" ] ;
       fhir:sliceName [ fhir:v "concept" ] ;
       fhir:short [ fhir:v "Data to be used, can be a reference to a resource, a CodeableConcept, or a base64 encoded string, a URL or a string" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ]
     ] [
       fhir:id [ fhir:v "Extension.extension:concept.extension" ] ;
       fhir:path [ fhir:v "Extension.extension.extension" ] ;
       fhir:max [ fhir:v "0" ]
     ] [

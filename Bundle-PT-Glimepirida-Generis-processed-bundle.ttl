     fhir:title [ fhir:v "Folheto informativo: Informação para o utilizador" ] ;
     fhir:code [
       fhir:coding ( [
         fhir:system [ fhir:v "https://spor.ema.europa.eu/v1/lists/200000029659/terms/"^^xsd:anyURI ] ;

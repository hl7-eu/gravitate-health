  fhir:section ( [
     fhir:title [ fhir:v "B. Package Leaflet" ] ;
     fhir:code [
       fhir:coding ( [
         fhir:system [ fhir:v "https://spor.ema.europa.eu/rmswi/"^^xsd:anyURI ] ;

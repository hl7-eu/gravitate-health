         fhir:text [
           fhir:status [ fhir:v "generated" ] ;
           fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><span>Ácido cítrico anhidro, bicarbonato de sodio, lactosa monohidratada, povidona, sacarina sódica, ciclamato de sodio, macrogol 6000, aroma de naranja (contiene maltodextrina procedente de maíz) y emulsión de simeticona.</span></p><p><span>Como componentes del colecalciferol concentrado en forma de polvo:</span><span>?</span><span>-tocoferol, aceite de soja hidrogenado, gelatina, sacarosa, almidón de maíz sin gluten y dióxido de silicio.</span></p><p><span> </span></p><p><span> </span></p><p><span> </span></p></div>"^^rdf:XMLLiteral ]

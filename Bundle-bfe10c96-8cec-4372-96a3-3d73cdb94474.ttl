         fhir:text [
           fhir:status [ fhir:v "generated" ] ;
           fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><span>Tubo de polipropileno con 15 comprimidos cada uno.</span></p><p><span>Cada envase contiene 30 comprimidos.</span></p><p><span> </span></p></div>"^^rdf:XMLLiteral ]

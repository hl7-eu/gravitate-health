         fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><span>Comprimido efervescente</span></p><p><span>Comprimidos efervescentes cilíndricos, de color blanco o blanquecino.</span></p></div>"^^rdf:XMLLiteral ]

           fhir:status [ fhir:v "generated" ] ;
           fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><strong><span> </span></strong></p><p><span>Si tiene cualquier otra duda sobre el uso de este medicamento, pregunte a su médico o farmacéutico.</span></p><p><span> </span></p></div>"^^rdf:XMLLiteral ]

     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\"><a name=\"Composition_composition-en-finasteride-pproc\"> </a><p class=\"res-header-id\"><b>Generated Narrative: Composition composition-en-finasteride-pproc</b></p><a name=\"composition-en-finasteride-pproc\"> </a><a name=\"hccomposition-en-finasteride-pproc\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Language: en</p><p style=\"margin-bottom: 0px\">Profile: <a href=\"http://hl7.org/fhir/uv/emedicinal-product-info/STU1/StructureDefinition-Composition-uv-epi.html\">Composition (ePI)</a></p></div><blockquote><p><b>HtmlElementLink</b></p><ul><li>elementClass: indication</li><li>concept: <span title=\"Codes:{http://snomed.info/sct 1259388006}\">Primary carcinoma of prostate</span></li></ul></blockquote><blockquote><p><b>LensesApplied</b></p><ul><li>lens: <a href=\"Library/conditions-lens\">Library/conditions-lens</a></li><li>elementClass: conditions-lens</li><li>explanation: This section was highlighted because you have a diagnosis of prostate cancer</li></ul></blockquote><blockquote><p><b>LensesApplied</b></p><ul><li>lens: <a href=\"Library-rmm-lens.html\">rmm-lens</a></li><li>elementClass: rmm-lens</li><li>explanation: Link added to online community to support patients with prostate cancer</li></ul></blockquote><blockquote><p><b>LensesApplied</b></p><ul><li>lens: <a href=\"Library-interaction-lens.html\">interaction-lens</a></li><li>elementClass: interaction-lens</li><li>explanation: Highlighted section because your medication may interact with your mood. Double-check how you feel.</li></ul></blockquote><blockquote><p><b>LensesApplied</b></p><ul><li>lens: <a href=\"Library/allergyintollerance-lens\">Library/allergyintollerance-lens</a></li><li>elementClass: allergyintollerance-lens</li><li>explanation: Highlighted section because you have a unconfirmed lactose intolerance</li></ul></blockquote><p><b>identifier</b>: <code>https://www.gravitatehealth.eu/sid/doc</code>/himss-finasteride</p><p><b>status</b>: Final</p><p><b>type</b>: <span title=\"Codes:{https://spor.ema.europa.eu/rmswi/ 100000155538}\">Package Leaflet</span></p><p><b>category</b>: <span title=\"Codes:{http://hl7.eu/fhir/ig/gravitate-health/CodeSystem/epicategory-cs P}\">Processed</span></p><p><b>date</b>: 2022-02-16 13:28:17+0000</p><p><b>author</b>: EMA</p><p><b>title</b>: TEST PURPOSES ONLY - finasteride</p><h3>Attesters</h3><table class=\"grid\"><tr><td style=\"display: none\">-</td><td><b>Mode</b></td><td><b>Time</b></td></tr><tr><td style=\"display: none\">*</td><td><span title=\"Codes:{http://hl7.org/fhir/composition-attestation-mode official}\">Official</span></td><td>2022-02-16 13:28:17+0000</td></tr></table></div>"^^rdf:XMLLiteral ]
